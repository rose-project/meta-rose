From 33fdefc734d6927aa2bd906c54d05eaa27bb5d2c Mon Sep 17 00:00:00 2001
From: Josef Raschen <josef@raschen.org>
Date: Thu, 2 Jul 2026 09:36:00 +0200
Subject: [PATCH 3/5] net: phy: microchip_t1: poll lan887x statistics
 periodically

The lan887x hardware statistics counters are only 8 to 16 bits wide and
clear on read (the driver already accumulates them into 64-bit sums).
They are read exclusively from the ethtool get_stats callback, so
unless the user polls "ethtool --phy-statistics" frequently the
counters wrap unnoticed and increments are lost.

Convert the accumulation to the update_stats callback so that phylib
reads and accumulates the counters once per state-machine cycle. The
legacy get_stats interface keeps reporting the accumulated 64-bit
values under the existing counter names.

Providing update_stats also puts the PHY into phy_polling_mode(), so
the phylib state machine now runs periodically even when the PHY
operates in interrupt mode. This is a prerequisite for recovering from
link loss: after a failed link training the PHY raises no new interrupt
edge, so recovery attempts cannot be interrupt-driven.

Assisted-by: Claude:claude-fable-5
Upstream-Status: Pending
---
 drivers/net/phy/microchip_t1.c | 33 ++++++++++++++++++---------------
 1 file changed, 18 insertions(+), 15 deletions(-)

diff --git a/drivers/net/phy/microchip_t1.c b/drivers/net/phy/microchip_t1.c
index 65dc585510bf..f4a85aba5f10 100644
--- a/drivers/net/phy/microchip_t1.c
+++ b/drivers/net/phy/microchip_t1.c
@@ -1524,34 +1524,36 @@ static int lan887x_probe(struct phy_device *phydev)
 	return 0;
 }
 
-static u64 lan887x_get_stat(struct phy_device *phydev, int i)
+static int lan887x_update_stats(struct phy_device *phydev)
 {
-	struct lan887x_hw_stat stat = lan887x_hw_stats[i];
 	struct lan887x_priv *priv = phydev->priv;
 	int val;
-	u64 ret;
 
-	if (stat.mmd)
-		val = phy_read_mmd(phydev, stat.mmd, stat.reg);
-	else
-		val = phy_read(phydev, stat.reg);
+	for (int i = 0; i < ARRAY_SIZE(lan887x_hw_stats); i++) {
+		struct lan887x_hw_stat stat = lan887x_hw_stats[i];
 
-	if (val < 0) {
-		ret = U64_MAX;
-	} else {
-		val = val & ((1 << stat.bits) - 1);
-		priv->stats[i] += val;
-		ret = priv->stats[i];
+		if (stat.mmd)
+			val = phy_read_mmd(phydev, stat.mmd, stat.reg);
+		else
+			val = phy_read(phydev, stat.reg);
+		if (val < 0)
+			return val;
+
+		priv->stats[i] += val & ((1 << stat.bits) - 1);
 	}
 
-	return ret;
+	return 0;
 }
 
 static void lan887x_get_stats(struct phy_device *phydev,
 			      struct ethtool_stats *stats, u64 *data)
 {
+	struct lan887x_priv *priv = phydev->priv;
+	int ret;
+
+	ret = lan887x_update_stats(phydev);
 	for (int i = 0; i < ARRAY_SIZE(lan887x_hw_stats); i++)
-		data[i] = lan887x_get_stat(phydev, i);
+		data[i] = ret ? U64_MAX : priv->stats[i];
 }
 
 static int lan887x_get_sset_count(struct phy_device *phydev)
@@ -2165,6 +2167,7 @@ static struct phy_driver microchip_t1_phy_driver[] = {
 		.get_stats      = lan887x_get_stats,
 		.get_sset_count = lan887x_get_sset_count,
 		.get_strings    = lan887x_get_strings,
+		.update_stats   = lan887x_update_stats,
 		.suspend	= genphy_suspend,
 		.resume		= genphy_resume,
 		.read_status	= genphy_c45_read_status,
