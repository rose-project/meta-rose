From df63d8b4e94d1dd5f5d663179581aae728661c2a Mon Sep 17 00:00:00 2001
From: Josef Raschen <josef@raschen.org>
Date: Thu, 2 Jul 2026 09:37:49 +0200
Subject: [PATCH 4/5] net: phy: microchip_t1: recover lan887x from link loss

When the LAN887x PHY core is reset behind the driver's back, e.g. by an
electrical disturbance, all registers revert to their hardware
defaults: the AFE/DSP/PCS calibration and the forced speed/role
configuration are lost and the PMA cannot retrain. The link then stays
down permanently; only rebinding the driver or rebooting recovers it,
and "ip link set dev ... up" on an administratively-up interface is a
no-op.

Add lan887x_read_status() which, when the link is down, saves the
statistics and calls phy_init_hw() + lan887x_config_aneg() to
reinitialize the PHY and retrain, mirroring dp83tg720_read_status() of
the TI 1000BASE-T1 driver. The state machine polls while the link is
down (the driver implements update_stats), so a failed attempt is
retried on the next cycle even in interrupt mode. Since with the link
down genphy_c45_read_pma() reads back the hardware defaults left by the
last reset rather than the configuration that must be restored,
read_status preserves the forced speed/duplex across
genphy_c45_read_status().

Add an asymmetric post-reset hold in lan887x_phy_reset(): the master
waits 97 ms and the slave 149 ms before training starts, so that the
master transmits its training signal before the slave starts to
listen. Without this, two link partners restarting link training at the
same time retrain in lockstep and never see each other's signal. The
values match dp83tg720_soft_reset(), which addresses the same
1000BASE-T1 failure mode.

Re-apply the calibration in config_aneg() after its errata chip reset;
previously the reset silently discarded it until the next
phy_init_hw().

Cache the applied (speed, role) configuration in config_aneg() and skip
the destructive errata reset when it is unchanged: phylib may call
config_aneg() repeatedly with the same effective configuration, e.g.
when a network manager runs "ethtool -s ... master-slave forced-slave"
right after phy_start(), and a redundant reset aborts an in-progress
training sequence. The cache is invalidated by config_init(), so the
first config_aneg() after phy_init_hw() (attach, resume, recovery)
always configures the hardware, and before every reset so that a
partial config_aneg() failure cannot leave a stale cache entry.

Fixes: 0941c8328234 ("net: phy: microchip_t1: Adds support for lan887x phy")
Assisted-by: Claude:claude-fable-5
Upstream-Status: Pending
---
 drivers/net/phy/microchip_t1.c | 109 +++++++++++++++++++++++++++++++--
 1 file changed, 105 insertions(+), 4 deletions(-)

diff --git a/drivers/net/phy/microchip_t1.c b/drivers/net/phy/microchip_t1.c
index f4a85aba5f10..8dc73175e989 100644
--- a/drivers/net/phy/microchip_t1.c
+++ b/drivers/net/phy/microchip_t1.c
@@ -329,6 +329,14 @@ struct lan887x_priv {
 	u64 stats[ARRAY_SIZE(lan887x_hw_stats)];
 	struct mchp_rds_ptp_clock *clock;
 	bool init_done;
+	/* Cache of the last applied configuration. config_aneg() skips its
+	 * destructive errata reset when the requested configuration is
+	 * unchanged. last_speed == SPEED_UNKNOWN marks the cache invalid;
+	 * config_init() resets it so that the first config_aneg() after a
+	 * phy_init_hw() always configures the hardware.
+	 */
+	int last_speed;
+	bool last_was_master;
 };
 
 static int lan937x_dsp_workaround(struct phy_device *phydev, u16 ereg, u8 bank)
@@ -1332,6 +1340,11 @@ static int lan887x_phy_init(struct phy_device *phydev)
 	struct lan887x_priv *priv = phydev->priv;
 	int ret;
 
+	/* Invalidate the configuration cache; the hardware is in its
+	 * post-reset state and config_aneg() must reconfigure it.
+	 */
+	priv->last_speed = SPEED_UNKNOWN;
+
 	/* Apply the AFE/DSP/PCS calibration here so that a single
 	 * phy_init_hw() call fully restores the PHY after any reset.
 	 */
@@ -1468,8 +1481,25 @@ static int lan887x_phy_reset(struct phy_device *phydev)
 		return ret;
 
 	/* Wait for reset complete or timeout if > 10ms */
-	return phy_read_poll_timeout(phydev, MII_BMCR, val, !(val & BMCR_RESET),
+	ret = phy_read_poll_timeout(phydev, MII_BMCR, val, !(val & BMCR_RESET),
 				    5000, 10000, true);
+	if (ret < 0)
+		return ret;
+
+	/* Asymmetric post-reset hold: the master exits reset first so that
+	 * it transmits its training signal before the slave starts to
+	 * listen. Without it, two link partners resetting at the same time
+	 * can retrain in lockstep and never see each other's signal. The
+	 * delay values match the dp83tg720 driver's 1000BASE-T1 post-reset
+	 * delays.
+	 */
+	if (phydev->master_slave_set == MASTER_SLAVE_CFG_MASTER_FORCE ||
+	    phydev->master_slave_set == MASTER_SLAVE_CFG_MASTER_PREFERRED)
+		msleep(97);
+	else
+		msleep(149);
+
+	return 0;
 }
 
 static int lan887x_phy_reconfig(struct phy_device *phydev)
@@ -1487,8 +1517,27 @@ static int lan887x_phy_reconfig(struct phy_device *phydev)
 
 static int lan887x_config_aneg(struct phy_device *phydev)
 {
+	struct lan887x_priv *priv = phydev->priv;
+	bool want_master;
 	int ret;
 
+	want_master = phydev->master_slave_set == MASTER_SLAVE_CFG_MASTER_FORCE ||
+		      phydev->master_slave_set == MASTER_SLAVE_CFG_MASTER_PREFERRED;
+
+	/* Skip the destructive reset below when the requested configuration
+	 * is already applied; phylib can call config_aneg() repeatedly with
+	 * the same settings, and a redundant reset would abort an
+	 * in-progress link training.
+	 */
+	if (phydev->speed == priv->last_speed &&
+	    want_master == priv->last_was_master)
+		return 0;
+
+	/* Invalidate the cache before resetting: if a step below fails, the
+	 * PHY is left unconfigured and the next call must not skip.
+	 */
+	priv->last_speed = SPEED_UNKNOWN;
+
 	/* LAN887x Errata: speed configuration changes require soft reset
 	 * and chip soft reset
 	 */
@@ -1496,6 +1545,11 @@ static int lan887x_config_aneg(struct phy_device *phydev)
 	if (ret < 0)
 		return ret;
 
+	/* Re-apply the AFE/DSP/PCS calibration wiped by the chip reset */
+	ret = lan887x_phy_setup(phydev);
+	if (ret < 0)
+		return ret;
+
 	ret = lan887x_phy_reconfig(phydev);
 	if (ret < 0)
 		return ret;
@@ -1504,10 +1558,16 @@ static int lan887x_config_aneg(struct phy_device *phydev)
 	 * the interrupt configuration so link events keep being reported in
 	 * IRQ mode.
 	 */
-	if (phy_interrupt_is_valid(phydev))
+	if (phy_interrupt_is_valid(phydev)) {
 		ret = phydev->drv->config_intr(phydev);
+		if (ret < 0)
+			return ret;
+	}
 
-	return ret;
+	priv->last_speed = phydev->speed;
+	priv->last_was_master = want_master;
+
+	return 0;
 }
 
 static int lan887x_probe(struct phy_device *phydev)
@@ -1519,6 +1579,7 @@ static int lan887x_probe(struct phy_device *phydev)
 		return -ENOMEM;
 
 	priv->init_done = false;
+	priv->last_speed = SPEED_UNKNOWN;
 	phydev->priv = priv;
 
 	return 0;
@@ -1567,6 +1628,46 @@ static void lan887x_get_strings(struct phy_device *phydev, u8 *data)
 		ethtool_puts(&data, lan887x_hw_stats[i].string);
 }
 
+static int lan887x_read_status(struct phy_device *phydev)
+{
+	int duplex = phydev->duplex;
+	int speed = phydev->speed;
+	int ret;
+
+	ret = genphy_c45_read_status(phydev);
+	if (ret < 0)
+		return ret;
+
+	if (phydev->link)
+		return 0;
+
+	/* With the link down, genphy_c45_read_pma() reported whatever the
+	 * last reset left in the PMA registers instead of the configuration
+	 * that must be restored; bring back the forced settings.
+	 */
+	phydev->speed = speed;
+	phydev->duplex = duplex;
+
+	/* Save the accumulated statistics before resetting the PHY */
+	ret = lan887x_update_stats(phydev);
+	if (ret < 0)
+		return ret;
+
+	/* The PHY does not recover from a link loss on its own: if the PHY
+	 * core was reset behind the driver's back, its calibration and
+	 * forced configuration are lost and it cannot retrain. The state
+	 * machine polls while the link is down (update_stats), so restore
+	 * the PHY and retry the link training once per cycle. The
+	 * asymmetric post-reset hold in lan887x_phy_reset() prevents
+	 * retraining in lockstep with the link partner.
+	 */
+	ret = phy_init_hw(phydev);
+	if (ret < 0)
+		return ret;
+
+	return lan887x_config_aneg(phydev);
+}
+
 static int lan887x_config_intr(struct phy_device *phydev)
 {
 	struct lan887x_priv *priv = phydev->priv;
@@ -2170,7 +2271,7 @@ static struct phy_driver microchip_t1_phy_driver[] = {
 		.update_stats   = lan887x_update_stats,
 		.suspend	= genphy_suspend,
 		.resume		= genphy_resume,
-		.read_status	= genphy_c45_read_status,
+		.read_status	= lan887x_read_status,
 		.cable_test_start = lan887x_cable_test_start,
 		.cable_test_get_status = lan887x_cable_test_get_status,
 		.config_intr    = lan887x_config_intr,
-- 
2.53.0

